# ============================================================
# SmartLar — variáveis de ambiente
# Copie este ficheiro para .env.local e preencha os valores.
# NUNCA faça commit do .env.local.
# ============================================================

# ---------- Supabase ----------
# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (apenas servidor). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Administração ----------
# E-mails autorizados a entrar em /admin (separados por vírgula).
# Cada e-mail deve existir em Supabase > Authentication > Users.
ADMIN_EMAILS=

# ---------- Meta Pixel (navegador) ----------
# Deixe vazio e o site funciona normalmente, sem Pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Meta Conversions API (servidor) ----------
META_CAPI_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Código de teste do Events Manager (opcional, apenas durante testes)
META_CAPI_TEST_EVENT_CODE=

# ---------- Notificações WhatsApp (servidor) ----------
# Número que recebe as notificações de novas encomendas.
# Formato internacional, apenas dígitos. Ex.: 258841234567
ADMIN_WHATSAPP_NUMBER=

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Template aprovado usado para notificar o administrador.
# Deixe vazio para usar mensagem de texto livre (só funciona dentro
# da janela de 24h de atendimento).
WHATSAPP_ADMIN_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT
# Template para o cliente. Enquanto vazio, o envio ao cliente fica desativado.
WHATSAPP_CUSTOMER_TEMPLATE_NAME=

# ---------- Notificações por e-mail (servidor) ----------
# E-mail que recebe a notificação de cada nova encomenda.
ADMIN_NOTIFICATION_EMAIL=
# Resend (https://resend.com) — plano gratuito chega para esta loja.
RESEND_API_KEY=
# Remetente: use onboarding@resend.dev para testar sem domínio próprio,
# ou um endereço do seu domínio depois de o verificar na Resend.
RESEND_FROM_EMAIL=

# ---------- Notificações push no navegador/telemóvel ----------
# Gere um par único com: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contacto exigido pelo protocolo Web Push (não é usado para enviar nada).
VAPID_SUBJECT=mailto:admin@example.com

# ---------- Pagamentos ----------
MPESA_NUMBER=858910700
EMOLA_NUMBER=870253638

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
